# Required for Pike13 scraping (Playwright login)
PIKE13_USER=
PIKE13_PASSWORD=

# Required for S3 sync
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
TRANSCRIBE_BUCKET=

# Required for summary email
SENDER_EMAIL=
SENDER_PASSWORD=

# Optional for transcript analysis (LLM)
OPENAI_API_KEY=

# Okta SSO credentials (optional — only used by scripts/extract_school_emails.py, not the cookie injection flow)
OKTA_USERNAME=
OKTA_PASSWORD=

# Path to cookie JSON file (generated by scripts/extract_pike13_cookies.py)
PIKE13_COOKIES_PATH=pike13_cookies.json

# Cookie freshness threshold (days before triggering alert)
PIKE13_COOKIE_MAX_AGE_DAYS=14

# Optional overrides for MCP server (defaults to local repo + notesreminder-db/reminders.db)
# REMINDERS_DB_PATH=/Users/you/path/to/reminders.db
# REMINDERS_S3_BUCKET=notesreminder-db
# REMINDERS_S3_KEY=reminders.db
# REMINDERS_MAX_ROWS=200
